# Flask / service
SEND_SERVER=http://127.0.0.1:5700
hostname=http://127.0.0.1:5000
DEBUG_SAVE_DIR=

# Model folder encryption key (leave empty if models are not encrypted)
MODEL_KEY=

# Object storage: proxy (default) or minio
STORAGE_MODE=proxy
S3_PROXY_SERVER=http://127.0.0.1:30230

# MinIO direct mode (only when STORAGE_MODE=minio)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false
